  <Place Angle="0" AngularSize="7" Classification="Galaxy" Constellation="AND" DataSetType="Sky" Dec="41.5927244444445" Magnitude="0" Name="PHAT M31" Opacity="100" RA="0.7436091666666655" Rotation="0" Thumbnail="http://data1.wwtassets.org/packages/2020/07_phat_m31/thumb.jpg" ZoomLevel="7">
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.8197882908523313" BaseTileLevel="0" BottomsUp="False" CenterX="11.686498572218326" CenterY="41.90823522094287" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Sharpest ever view of the Andromeda Galaxy;Andromeda Galaxy;M 31;Messier 31" OffsetX="-0.483202756087923" OffsetY="-0.154475340368076" Projection="Tan" QuadTreeMap="" Rotation="-236.10668016489333" Sparse="True" StockSet="False" TileLevels="9" Url="http://data1.wwtassets.org/packages/2020/07_phat_m31/{1}/{3}/{3}_{2}.png" WidthFactor="2" Xcxstatus="in:649ba2b61e6961df10c19447">
        <Credits>NASA, ESA, J. Dalcanton (University of Washington, USA), B.
        F. Williams (University of Washington, USA), L. C. Johnson (University
        of Washington, USA), the PHAT team, and R. Gendler. Astrometric
        alignment by A. David Weigel (US Space &amp; Rocket Center).</Credits>
        <CreditsUrl>https://esahubble.org/images/heic1502a/</CreditsUrl>
        <Description>This image, captured with the NASA/ESA Hubble Space
        Telescope, is the largest and sharpest image ever taken of the
        Andromeda galaxy — otherwise known as M31. The full image has 1.5
        billion pixels. You would need more than 600 HD television screens to
        display the whole image at once. It is the biggest Hubble image ever
        released and shows over 100 million stars and thousands of star
        clusters embedded in a section of the galaxy’s pancake-shaped disc
        stretching across over 40,000 light-years.</Description>
        <ThumbnailUrl>http://data1.wwtassets.org/packages/2020/07_phat_m31/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
