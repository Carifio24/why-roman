  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;eso&quot;, &quot;itemid&quot;: &quot;eso0925b&quot;, &quot;publishedUTCISO8601&quot;: &quot;2015-09-23T12:00:00+00:00&quot;}" Constellation="SGR" DataSetType="Sky" Dec="-16.16499248980093" Magnitude="0" Name="Digitized Sky Survey Image of the Omega Nebula (M 17)" Opacity="100" RA="18.346701431511217" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/eso/eso0925b/thumb.jpg" ZoomLevel="37.837356990192">
    <Description>This image is a colour composite of the Omega Nebula (M 17) made from exposures from the Digitized Sky Survey 2 (DSS2). The field of view is approximatelly 4.7 x 3.7 degrees.</Description>
