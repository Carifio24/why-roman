  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-03470&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:53:41.245548+00:00&quot;}" Constellation="DOR" DataSetType="Sky" Dec="-69.20580644530429" Magnitude="0" Name="Supernova 1987A in the Large Magellanic Cloud" Opacity="100" RA="5.606446090962909" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-03470/thumb.jpg" ZoomLevel="11.338034399999998">
    <Description>Supernova 1987A in the Large Magellanic Cloud appears as a very bright object near the center of this color photograph made by Marcelo Bass of the National Optical Astronomy Observatories (NOAO). The photograph was taken at NOAO&amp;#x27;s Cerro-Tololo Inter-American Observatory, on March 2nd 1987, using the CTIO Curtis Schmidt telescope.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.6220159999999997" BaseTileLevel="0" BottomsUp="False" CenterX="83.43703808" CenterY="-69.33555125" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Supernova 1987A in the Large Magellanic Cloud" OffsetX="-0.23804420597999998" OffsetY="0.12118026610799996" Projection="Tan" QuadTreeMap="" Rotation="-1.7590601028032546" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-03470/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:64276287975014bc743f1687">
