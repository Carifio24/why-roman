      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.55286175744" BaseTileLevel="0" BottomsUp="False" CenterX="6.022499" CenterY="-72.081497" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="The globular star cluster 47 Tucanae" OffsetX="-0.0005814670113053774" OffsetY="0.003876811111354554" Projection="Tan" QuadTreeMap="" Rotation="6.26883496186" Sparse="True" StockSet="False" TileLevels="6" Url="http://data1.wwtassets.org/feeds/eso/eso1302a/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="eso|eso1302a" Xcxstatus="queue:eso">
