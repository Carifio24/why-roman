  <Place Angle="0" AngularSize="9.32770242241828" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-m31lgs_ubvIha&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:48+00:00&quot;}" Constellation="AND" DataSetType="Sky" Dec="41.21023351974203" Magnitude="0" Name="Panorama of Spiral Galaxy, M31" Opacity="100" RA="0.7136418341101134" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-m31lgs_ubvIha/thumb.jpg" ZoomLevel="9.32770242241828">
    <Description>This image was created with data from the Local Group Survey, completed with the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. M31, M33 and our Milky Way are the three largest members of the Local Group of galaxies. M31 is a spiral galaxy very similar in size and mass to our own. Ten &amp;#x27;pointings&amp;#x27; of the camera along the galaxy in five filters were used to make the image. You could line seven full moons across the image. The image was generated with observations with the U (violet), B (blue), V (cyan), I (orange) and H-alpha (red) filters. The five filters show the star colors and HII star forming regions in vivid detail. About 600 million pixels in size, it is the largest and most detailed image of M31 ever completed that covers the entire galaxy. This image is rotated CW 127 degrees from North is up, East to the left.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="4.915081897729445" BaseTileLevel="0" BottomsUp="False" CenterX="10.705332948735478" CenterY="41.209118974339745" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Panorama of Spiral Galaxy, M31" OffsetX="7.50497028846e-05" OffsetY="7.50497028846e-05" Projection="Tan" QuadTreeMap="" Rotation="125.83999999999997" Sparse="True" StockSet="False" TileLevels="8" Url="http://data1.wwtassets.org/feeds/noirlab/noao-m31lgs_ubvIha/{1}/{3}/{3}_{2}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-m31lgs_ubvIha" Xcxstatus="in:642762ae975014bc743f16db">
        <Credits>Local Group Survey Team and T.A. Rector (University of Alaska Anchorage)</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-m31lgs_ubvIha/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-m31lgs_ubvIha/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
