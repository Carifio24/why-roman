        <CreditsUrl>https://www.eso.org/public/images/eso0919c/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/eso/eso0919c/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="0" Constellation="DOR" DataSetType="Sky" Dec="-68.2141" Magnitude="0" Name="Large Magellanic Cloud;LMC" Opacity="100" RA="5.304726" Rotation="0" ZoomLevel="65">
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="13.69" BaseTileLevel="0" BottomsUp="False" CenterX="79.5709" CenterY="-68.2141" DataSetType="Sky" ElevationModel="False" FileType="png" Generic="False" Name="Large Magellanic Cloud;LMC" OffsetX="0.025" OffsetY="-0.1" Projection="Tan" QuadTreeMap="0123" Rotation="0" Sparse="True" StockSet="False" TileLevels="7" Url="http://r{S:0}.ortho.tiles.virtualearth.net/tiles/wsa0000011331{Q}?g=138" WidthFactor="2" Xcxstatus="in:64276318975014bc743f17b9">
        <Credits>C. Smith, S. Points, the MCELS Team and NOAO/AURA/NSF</Credits>
        <CreditsUrl>http://www.noao.edu/image_gallery/html/im0994.html</CreditsUrl>
