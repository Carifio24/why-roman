      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.0225299891035" BaseTileLevel="0" BottomsUp="False" CenterX="269.921027518175" CenterY="-23.1869916631852" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="W28: A Mixed Bag;W28;G6.4-0.1" OffsetX="-0.239602014594099" OffsetY="-0.252753734296919" Projection="Tan" QuadTreeMap="" Rotation="0.268521009350113" Sparse="True" StockSet="False" TileLevels="4" Url="http://www.worldwidetelescope.org/wwtweb/tiles.aspx?q={1},{2},{3},1912661927" WidthFactor="2" Xcxstatus="in:6745e470ed25b6eaa0b178a8">
        <Credits>Chandra X-ray: NASA/CXC/HSC/J. Keohane et al.; ROSAT X-ray: NASA/ROSAT; Optical: NOAO/CTIO/P.F. Winkler et al.; Radio: NSF/NRAO/VLA/G. Dubner et al.
