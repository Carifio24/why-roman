      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.155072" BaseTileLevel="0" BottomsUp="False" CenterX="313.9317320015711" CenterY="31.74015501909416" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Veil Nebula (partial)" OffsetX="-0.06800005984800003" OffsetY="-0.28112236016400005" Projection="Tan" QuadTreeMap="" Rotation="-2.705019773" Sparse="True" StockSet="False" TileLevels="3" Url="http://data1.wwtassets.org/feeds/noirlab/noao-veile/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-veile" Xcxstatus="in:642762e0975014bc743f1743">
