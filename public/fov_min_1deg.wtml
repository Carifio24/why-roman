  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02210&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:03.352640+00:00&quot;}" Constellation="CAR" DataSetType="Sky" Dec="-59.71614622408022" Magnitude="0" Name="The Eta Carinae nebula, NGC 3372" Opacity="100" RA="10.749653988685022" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02210/thumb.jpg" ZoomLevel="9.319536">
    <Description>The Eta Carinae nebula, NGC3372, as seen from CTIO.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.9251199999999997" BaseTileLevel="0" BottomsUp="False" CenterX="161.2215847" CenterY="-59.49815611" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="The Eta Carinae nebula, NGC 3372" OffsetX="-0.04696336784999999" OffsetY="-0.21319629156999995" Projection="Tan" QuadTreeMap="" Rotation="9.446171570387413" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-02210/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-02210" Xcxstatus="in:6427626f975014bc743f1654">
