  </Place>
  <Place Angle="0" AngularSize="10.038064799999999" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-m52r&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:07+00:00&quot;}" Constellation="CAS" DataSetType="Sky" Dec="61.425432545958024" Magnitude="0" Name="M52 and the Bubble Nebula" Opacity="100" RA="23.377336336589494" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-m52r/thumb.jpg" ZoomLevel="10.038064799999999">
    <Description>Open star cluster M52 (NGC7654) and the Bubble emission nebula (NGC7635). This combination of CCD images from the Kitt Peak Burrell Schmidt telescope extends more than a degree across the sky (twice the diameter of the full moon). A closer view of M52 is also available, as well as an excellently detailed image of the Bubble Nebula from the KPNO 2.1-meter telescope.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.153024" BaseTileLevel="0" BottomsUp="False" CenterX="350.5282181961818" CenterY="61.413641515275934" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="M52 and the Bubble Nebula" OffsetX="-0.06310345504480003" OffsetY="0.008668564316100014" Projection="Tan" QuadTreeMap="" Rotation="-1.869315729" Sparse="True" StockSet="False" TileLevels="3" Url="http://data1.wwtassets.org/feeds/noirlab/noao-m52r/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:642762b2975014bc743f16e2">
        <Credits>N.A.Sharp, REU program/NOIRLab/NSF/AURA</Credits>
