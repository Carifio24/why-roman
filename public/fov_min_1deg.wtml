  </Place>
  <Place Angle="0" AngularSize="0" Constellation="SCO" DataSetType="Sky" Dec="-35.963071" Magnitude="0" Name="Cat's Paw Nebula" Opacity="100" RA="17.3327836" Rotation="0" Thumbnail="http://wwtfiles.blob.core.windows.net/vamp/thumb-ESO-eso1003b.jpg" ZoomLevel="9.03968587776">
