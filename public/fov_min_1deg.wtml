  <Place Angle="0" AngularSize="0" Constellation="CAS" DataSetType="Sky" Dec="56.62393729710345" Magnitude="0" Name="NGC 281 Star-Forming Region" Opacity="100" RA="0.8782663" Rotation="0" ZoomLevel="6">
