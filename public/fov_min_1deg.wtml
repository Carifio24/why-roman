  <Place Angle="0" AngularSize="53.1815621936593" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noirlab2018e&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-08-04T13:18:29+00:00&quot;}" Constellation="TAU" DataSetType="Sky" Dec="15.580832234503042" Magnitude="0" Name="The Hyades star cluster" Opacity="100" RA="4.475567807049053" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noirlab2018e/thumb.jpg" ZoomLevel="53.1815621936593">
