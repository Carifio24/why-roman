  <Place Angle="0" AngularSize="2.549092366193885" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noaoann13006a&quot;, &quot;publishedUTCISO8601&quot;: &quot;2013-11-07T00:00:00+00:00&quot;}" Constellation="PER" DataSetType="Sky" Dec="45.405038165051465" Magnitude="0" Name="Planetary Nebula HDW 3" Opacity="100" RA="3.454547313089968" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noaoann13006a/thumb.jpg" ZoomLevel="2.549092366193885">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. Hartl-Dengel-Weinberger 3 (HDW 3) is a large, ancient planetary nebula. Its distinctive braided shape is the result of the planetary nebula colliding with the interstellar gas around it as the nebula moves through the galaxy. The star that produced the planetary nebula is the faint bluish one just below and to the right of the bright star near the center of the image.The image was generated with observations in Hydrogen alpha (red) and Oxygen III (blue) filters. In this image, North is up, East is to the left.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.5954831429541887" BaseTileLevel="0" BottomsUp="False" CenterX="51.811659493997084" CenterY="45.3032633541649" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Planetary Nebula HDW 3" OffsetX="-0.004815465769503923" OffsetY="0.10152932739169922" Projection="Tan" QuadTreeMap="" Rotation="-0.11827379172561302" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noaoann13006a/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noaoann13006a" Xcxstatus="in:642762fc975014bc743f1780">
        <Credits>T.A. Rector (University of Alaska Anchorage) and H. Schweiker (WIYN and NOIRLab/NSF/AURA)</Credits>
