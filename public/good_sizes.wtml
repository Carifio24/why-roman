  <Place Angle="0" AngularSize="0" Constellation="SGE" DataSetType="Sky" Dec="18.8988" Magnitude="0" Name="G54.1+0.3" Opacity="100" RA="19.4906" Rotation="0" Thumbnail="http://wwtfiles.blob.core.windows.net/vamp/thumb-Spitzer-ssc2010-04a.jpg" ZoomLevel="5.08102296748351">
