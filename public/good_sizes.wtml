  <Place Angle="0" AngularSize="3.939146201495487" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao1601b&quot;, &quot;publishedUTCISO8601&quot;: &quot;2016-05-25T00:00:00+00:00&quot;}" Constellation="COM" DataSetType="Sky" Dec="27.97306655016532" Magnitude="0" Name="A Young Mammoth Cluster of Galaxies Sighted in the Early Universe" Opacity="100" RA="12.997144669877912" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao1601b/thumb.jpg" ZoomLevel="3.939146201495487">
    <Description>Coma Cluster image from the Sloan Digital Sky Survey.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.571060481394688" BaseTileLevel="0" BottomsUp="False" CenterX="194.95754641741408" CenterY="27.97238597116303" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="A Young Mammoth Cluster of Galaxies Sighted in the Early Universe" OffsetX="0.000278838125681" OffsetY="0.000278838125681" Projection="Tan" QuadTreeMap="" Rotation="0" Sparse="True" StockSet="False" TileLevels="3" Url="http://data1.wwtassets.org/feeds/noirlab/noao1601b/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao1601b" Xcxstatus="in:642762f8975014bc743f1777">
