  <Place Angle="0" AngularSize="4.026960000000001" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-m26&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:16+00:00&quot;}" Constellation="SCT" DataSetType="Sky" Dec="-9.389350353951498" Magnitude="0" Name="M26, NGC 6694" Opacity="100" RA="18.754240349769923" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-m26/thumb.jpg" ZoomLevel="4.026960000000001">
    <Description>M26 is an open cluster in the constellation Scutum. A fairly tight cluster, in this deep image it has to compete with a very populous background of Milky Way stars. It is about 5000 light-years away and around 90 million years old. This approximately true-color picture was created from images taken in June 1996 using BVR colors, at the Burrell Schmidt telescope of Case Western Reserve University&amp;#x27;s Warner and Swasey Observatory located on Kitt Peak, near Tucson, Arizona, during the Research Experiences for Undergraduates (REU) program operated at the Kitt Peak National Observatory and supported by the National Science Foundation. Image size 23.7 arc minutes.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.577536" BaseTileLevel="0" BottomsUp="False" CenterX="281.330155108746" CenterY="-9.428083771263553" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="M26, NGC 6694" OffsetX="0.014682650182800003" OffsetY="0.0386900957784" Projection="Tan" QuadTreeMap="" Rotation="-2.616242942" Sparse="True" StockSet="False" TileLevels="3" Url="http://data1.wwtassets.org/feeds/noirlab/noao-m26/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:642762ab975014bc743f16d5">
        <Credits>Hillary Mathis, Vanessa Harvey, REU program/NOIRLab/NSF/AURA</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-m26/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-m26/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
