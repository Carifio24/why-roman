  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-m81m82&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:52+00:00&quot;}" Constellation="UMA" DataSetType="Sky" Dec="69.31928190292632" Magnitude="0" Name="Galaxies M81 &amp; M82" Opacity="100" RA="9.92159419991845" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-m81m82/thumb.jpg" ZoomLevel="5.587111200000001">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the KPNO 0.9m-meter telescope at Kitt Peak National Observatory. M81 (the spiral galaxy on the left) and M82 (the galaxy on the right) are two relatively nearby galaxies that are gravitationally interacting with each other. This interaction is triggering the formation of new stars in M82 at a massive rate, which can be seen from the filaments of red hydrogen gas in the galaxy. The very faint irregular dwarf galaxy Holmberg IX can barely be seen above M81. The image was generated with observations in B (blue), V (cyan), R (green), I (orange) and Hydrogen-Alpha (red). In this image, North is right, East is up.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.933312" BaseTileLevel="0" BottomsUp="False" CenterX="148.7093692" CenterY="69.22847295" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Galaxies M81 &amp; M82" OffsetX="0.09097383719600001" OffsetY="0.04016594613200001" Projection="Tan" QuadTreeMap="" Rotation="90.18048792" Sparse="True" StockSet="False" TileLevels="6" Url="http://data1.wwtassets.org/feeds/noirlab/noao-m81m82/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-m81m82" Xcxstatus="in:642762be975014bc743f16fb">
        <Credits>T.A. Rector (University of Alaska Anchorage) and NOIRLab/NSF/AURA/</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-m81m82/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-m81m82/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
