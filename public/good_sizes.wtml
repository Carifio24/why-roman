  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao1207a&quot;, &quot;publishedUTCISO8601&quot;: &quot;2012-12-04T00:00:00+00:00&quot;}" Constellation="CAS" DataSetType="Sky" Dec="61.17809018235457" Magnitude="0" Name="Wide field view of NGC 7635" Opacity="100" RA="23.345064958916144" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao1207a/thumb.jpg" ZoomLevel="5.300763587919184">
    <Description>This wide field view of NGC 7635 shows the nebulosity carved out by the winds of the massive central star and demonstrates the exquisite image quality of the new One Degree Imager camera on the WIYN 3.5-m telescope. An image of the central portion of the nebula, cosmetically corrected, is found here. For more information, see NOAO Press Release 12-07.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.0018805005320193" BaseTileLevel="0" BottomsUp="False" CenterX="350.176037339" CenterY="61.1780593841" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Wide field view of NGC 7635" OffsetX="3.05749664469e-05" OffsetY="3.05749664469e-05" Projection="Tan" QuadTreeMap="" Rotation="0.42000000000000015" Sparse="True" StockSet="False" TileLevels="7" Url="http://data1.wwtassets.org/feeds/noirlab/noao1207a/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao1207a" Xcxstatus="in:642762f4975014bc743f176e">
        <Credits>T.A. Rector (University of Alaska Anchorage), WIYN ODI team &amp;amp; WIYN/NOIRLab/NSF/AURA</Credits>
