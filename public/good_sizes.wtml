        <ThumbnailUrl>http://data1.wwtassets.org/feeds/eso/potw1619a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02351&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:47+00:00&quot;}" Constellation="HYA" DataSetType="Sky" Dec="3.1832898874455386" Magnitude="0" Name="Cluster of galaxies in Hydra" Opacity="100" RA="8.963271360717908" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02351/thumb.jpg" ZoomLevel="2.1216">
    <Description>This distant cluster of galaxies in the constellation Hydra clearly shows the mythological water serpent. KPNO 4-meter Mayall telescope, 1974.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.425984" BaseTileLevel="0" BottomsUp="False" CenterX="134.503723" CenterY="3.218631358" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Cluster of galaxies in Hydra" OffsetX="0.0552723183915" OffsetY="-0.03422844578399999" Projection="Tan" QuadTreeMap="" Rotation="-1.1485829228021505" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-02351/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-02351" Xcxstatus="in:64276280975014bc743f1677">
