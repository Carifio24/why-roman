  </Place>
  <Place Angle="0" AngularSize="0" Constellation="DRA" DataSetType="Sky" Dec="68.0377902554105" Magnitude="0" Name="L1157" Opacity="100" RA="20.6517077671797" Rotation="0" Thumbnail="http://wwtfiles.blob.core.windows.net/vamp/thumb-Spitzer-ssc2007-19a.jpg" ZoomLevel="2.4627627235634">
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.61569068089085" BaseTileLevel="0" BottomsUp="False" CenterX="309.775616507696" CenterY="68.0377902554105" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="L1157" Projection="Tan" QuadTreeMap="" Rotation="-354.766508332" Sparse="True" StockSet="False" TileLevels="4" Url="http://wwtfiles.blob.core.windows.net/vamp/Spitzer-ssc2007-19aL{1}X{2}Y{3}.png" WidthFactor="1" Xcxstatus="in:64b744b3a15b29de42b30607">
