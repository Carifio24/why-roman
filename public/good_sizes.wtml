  <Place Angle="0" AngularSize="1" Classification="Unfiltered" Constellation="SGR" DataSetType="Sky" Dec="-27.1666666666667" Magnitude="0" Name="G1.9+0.3: Discovery of Most Recent Supernova in Our Galaxy;SNR G001.9+00.3" Opacity="100" RA="17.8125" Rotation="0" ZoomLevel="2.81166666666667">
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.142222225664" BaseTileLevel="0" BottomsUp="False" CenterX="267.186835494207" CenterY="-27.1666666667" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="G1.9+0.3: Discovery of Most Recent Supernova in Our Galaxy;G1.9+0.3;SNR G001.9+00.3" OffsetX="-0.00180555559925" OffsetY="-0.00208333338375" Projection="Tan" QuadTreeMap="" Rotation="0" Sparse="True" StockSet="False" TileLevels="1" Url="http://www.worldwidetelescope.org/wwtweb/tiles.aspx?q={1},{2},{3},269828725" WidthFactor="2" Xcxstatus="in:6745e473ed25b6eaa0b178ae">
        <Credits>X-ray (NASA/CXC/NCSU/S.Reynolds et al.); Radio (NSF/NRAO/VLA/Cambridge/D.Green et al.) This composite image of the supernova remnant G1.9+0.3 combines the Chandra X-ray Observatory image taken in 2007 (orange) with the Very Large Array radio image taken in 1985 (blue) and 2008 (yellow). The difference in size between the images gives clear evidence for expansion, allowing the age of the remnant and the time since the original supernova explosion (about 140 years) to be estimated. </Credits>
        <CreditsUrl>https://chandra.harvard.edu/photo/2008/g19/more.html#img8</CreditsUrl>
