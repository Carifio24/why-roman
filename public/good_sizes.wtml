  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02324&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:59+00:00&quot;}" Constellation="CYG" DataSetType="Sky" Dec="60.14425457799509" Magnitude="0" Name="NGC 6946 in Cygnus" Opacity="100" RA="20.581168082226913" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02324/thumb.jpg" ZoomLevel="2.142">
    <Description>NGC6946 (Arp 29) is a face-on SAB(rs)cd galaxy in the constellation Cygnus. This classification refers to the presence of a small core with multiple well-defined arms (cd), with a poorly-developed bar across the middle (AB) and an inner confused ring (rs). Nearly twenty million light-years from Earth, it is over seventy thousand light-years across and more than fills this picture. At least one supernova has been observed in this galaxy. KPNO 4-meter Mayall telescope, 1975.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.43007999999999996" BaseTileLevel="0" BottomsUp="False" CenterX="308.9093193" CenterY="60.17652515" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 6946 in Cygnus" OffsetX="0.09640747830479997" OffsetY="-0.02923333717500001" Projection="Tan" QuadTreeMap="" Rotation="-1.7475076263084777" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-02324/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:64276277975014bc743f1665">
