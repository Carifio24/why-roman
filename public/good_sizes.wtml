  </Place>
  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-vdb24&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:12+00:00&quot;}" Constellation="PER" DataSetType="Sky" Dec="38.98950624788021" Magnitude="0" Name="vdB 24, Star XY Per" Opacity="100" RA="3.8257233494325664" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-vdb24/thumb.jpg" ZoomLevel="2.4137126999999996">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. vdB 24 is a reflection nebula in the constellation of Perseus. It is illuminated by the luminous and variable star &amp;#x27;XY Per&amp;#x27;, which is the bright star just below the blue nebulosity near the center of the image. vdB 24 is embedded in a larger dark nebula called LDN 1442, which can be seen as the brownish gas surrounding it. The image was generated with observations in the B (blue), V (green) and I (red). In this image, North is down and East is to the right.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.29777919999999997" BaseTileLevel="0" BottomsUp="False" CenterX="57.26524712" CenterY="38.88582143" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="vdB 24, Star XY Per" OffsetX="0.09416118748409999" OffsetY="-0.10336519093039999" Projection="Tan" QuadTreeMap="" Rotation="179.76683087571502" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-vdb24/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:642762df975014bc743f1741">
