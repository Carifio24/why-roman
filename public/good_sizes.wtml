      <ImageSet BandPass="IR" BaseDegreesPerTile="0.228565804465758" BaseTileLevel="0" BottomsUp="False" CenterX="202.467618627228" CenterY="47.213648331965" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="A Classic Beauty;Messier 51;Whirlpool Galaxy;NGC 5194" OffsetX="-5.60272e-05" OffsetY="-5.60272e-05" Projection="Tan" QuadTreeMap="0123" Rotation="1.9" Sparse="True" StockSet="False" TileLevels="4" Url="http://r{S:3}.ortho.tiles.virtualearth.net/tiles/wsa0000120223{Q}?g=182" WidthFactor="2" Xcxstatus="in:64b74497a15b29de42b305cb">
