  <Place Angle="0" AngularSize="0" Constellation="LEO" DataSetType="Sky" Dec="7.8248841750373845" Magnitude="0" Name="Seeing the Hidden Truth" Opacity="100" RA="9.85483904055597" Rotation="0" ZoomLevel="1.9545112051200002">
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="9.980143e-05" BaseTileLevel="0" BottomsUp="False" CenterX="147.821838" CenterY="7.82557" DataSetType="Sky" ElevationModel="False" FileType=".jpg" Generic="False" Name="Seeing the Hidden Truth" OffsetX="967.46692512901" OffsetY="950.32218555783" Projection="SkyImage" QuadTreeMap="" Rotation="0.3825545348800001" Sparse="True" StockSet="False" TileLevels="0" Url="http://data1.wwtassets.org/feeds/nrao/nrao_nrao_gallery027/image.jpg" WidthFactor="2" Xastropix_ids="nrao|NRAO_Gallery027" Xcorepipe_ids="nrao|nrao_nrao_gallery027" Xcxstatus="in:6682c5daa0402c750ca6ce98">
        <Credits>B. Saxton from data provided by Van Zee, NOAO, NRAO/AUI/NSF</Credits>
        <CreditsUrl>https://public.nrao.edu/gallery/seeing-the-hidden-truth/</CreditsUrl>
        <Description>Dwarf galaxy UGC 5288 is 16 million light-years from Earth (seen here in pink). The Very Large Array (VLA) found that it is surrounded by a huge disk of hydrogen gas (purple) that has not been involved in the galaxy\'s star-formation processes and may be primordial material left over from the galaxy\'s formation.</Description>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/nrao/nrao_nrao_gallery027/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
