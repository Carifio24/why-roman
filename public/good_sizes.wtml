  <Place Angle="0" AngularSize="0" Constellation="SGR" DataSetType="Sky" Dec="-28.916073002831297" Magnitude="0" Name="SOFIA Reveals New View of Milky Way Center" Opacity="100" RA="17.764829231993264" Rotation="0" Thumbnail="http://data1.wwtassets.org/packages/2021/02_sofia/galactic_center_pano_sofia/thumb.jpg" ZoomLevel="3.823815430689569">
    <Description>Composite infrared image of the center of our Milky way Galaxy. It spans 600+ lightyears across and is helping scientists learn how many massive stars are forming in our galaxy’s center. New data from SOFIA taken at 25 and 37 microns, shown in blue and green, is combined with data from the Herschel Space Observatory, shown in red (70 microns), and the Spitzer Space Telescope, shown in white (8 microns). SOFIA&amp;#x27;s view reveals features that have never been seen before.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="2.274850835745022" BaseTileLevel="0" BottomsUp="False" CenterX="266.472438479899" CenterY="-28.9160730028313" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="SOFIA Reveals New View of Milky Way Center" Projection="Tan" QuadTreeMap="" Rotation="-58.63842102162298" Sparse="False" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/packages/2021/02_sofia/galactic_center_pano_sofia/{1}/{3}/{3}_{2}.png" WidthFactor="2" Xcxstatus="in:647a7addd4a2d5e2c5f3e71d">
        <Credits>NASA/SOFIA/JPL-Caltech/ESA/Herschel</Credits>
        <CreditsUrl>https://www.nasa.gov/feature/sofia-reveals-new-view-of-milky-way-s-center</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/packages/2021/02_sofia/galactic_center_pano_sofia/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
