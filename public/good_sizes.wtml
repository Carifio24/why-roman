  </Place>
  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02215&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:15+00:00&quot;}" Constellation="PEG" DataSetType="Sky" Dec="12.171821737203185" Magnitude="0" Name="M15, NGC 7078" Opacity="100" RA="21.499415986107937" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02215/thumb.jpg" ZoomLevel="3.7943999999999996">
    <Description>M15, or NGC7078, a globular cluster in the constellation Pegasus, as seen by the KPNO 4-m telescope in 1975. M15 is a strong X-ray source, about 34000 light-years away and about 130 light-years across. It is unusual in that it contains a small planetary nebula (K648) in the northeast side (just below the center at the left). Orientation: north left, east down.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.761856" BaseTileLevel="0" BottomsUp="False" CenterX="322.6006208" CenterY="12.12860229" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="M15, NGC 7078" OffsetX="-0.04477371640799999" OffsetY="0.10628952062159999" Projection="Tan" QuadTreeMap="" Rotation="-90.83262097276834" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-02215/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:64276271975014bc743f1657">
        <Credits>NOIRLab/NSF/AURA</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-02215/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-02215/thumb.jpg</ThumbnailUrl>
      </ImageSet>
