  <Place Angle="0" AngularSize="2.5703999999999994" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02276&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:51.731628+00:00&quot;}" Constellation="PSC" DataSetType="Sky" Dec="15.7884460031624" Magnitude="0" Name="M74, NGC 628" Opacity="100" RA="1.61191686951847" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02276/thumb.jpg" ZoomLevel="2.5703999999999994">
