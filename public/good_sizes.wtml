  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;eso&quot;, &quot;itemid&quot;: &quot;eso0943b&quot;, &quot;publishedUTCISO8601&quot;: &quot;2009-11-17T00:00:00+00:00&quot;}" Constellation="PUP" DataSetType="Sky" Dec="-25.949970449076904" Magnitude="0" Name="Around the nova V445 Puppis annotated" Opacity="100" RA="7.632454350536422" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/eso/eso0943b/thumb.jpg" ZoomLevel="5.956471663632">
    <Description>This wide-field image, based on data from Digitized Sky Survey 2, shows the whole region around the nova V445 Puppis, with the double star system highlighted.</Description>
