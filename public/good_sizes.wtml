      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.387072" BaseTileLevel="0" BottomsUp="False" CenterX="199.0850530298046" CenterY="42.08797739189487" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="M63, NGC 5055" OffsetX="0.10974405576330001" OffsetY="-0.04893283369799999" Projection="Tan" QuadTreeMap="" Rotation="-1.2283462640000002" Sparse="True" StockSet="False" TileLevels="3" Url="http://data1.wwtassets.org/feeds/noirlab/noao-m63/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:642762b5975014bc743f16e9">
