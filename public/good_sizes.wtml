        <ThumbnailUrl>http://data1.wwtassets.org/feeds/eso/potw1448a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="0" Constellation="CEN" DataSetType="Sky" Dec="-41.9356537" Magnitude="0" Name="SN 1006" Opacity="100" RA="15.0471800666667" Rotation="0" Thumbnail="http://wwtfiles.blob.core.windows.net/vamp/thumb-Chandra-538.jpg" ZoomLevel="2.54707531776">
