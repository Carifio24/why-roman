  <Place Angle="0" AngularSize="5.3150976" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-ngc6820&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:09+00:00&quot;}" Constellation="VUL" DataSetType="Sky" Dec="23.25914212236542" Magnitude="0" Name="NGC 6820/3, Emission Nebula/Open Cluster" Opacity="100" RA="19.720755702183318" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-ngc6820/thumb.jpg" ZoomLevel="5.3150976">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the KPNO 0.9m-meter telescope at Kitt Peak National Observatory. NGC 6820 is a diffuse emission nebula that surrounds the open cluster of stars NGC 6823 (at the center of the image). The intense light from the hot, massive stars in the cluster is blowing away the gas in the nebula, causing the distinctive &amp;quot;pillar&amp;quot; shapes on the left side of the image. The image was generated with observations in Hydrogen alpha (red), Oxygen [OIII] (green) and Sulfur [SII] (blue) filters. In this image, North is up, East is to the left.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.966656" BaseTileLevel="0" BottomsUp="False" CenterX="295.95149341441197" CenterY="23.163720051215773" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 6820/3, Emission Nebula/Open Cluster" OffsetX="0.12924325051199997" OffsetY="0.094404789384" Projection="Tan" QuadTreeMap="" Rotation="0.38148937650000003" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noao-ngc6820/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-ngc6820" Xcxstatus="in:642762d6975014bc743f172e">
        <Credits>T.A. Rector (University of Alaska Anchorage)</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-ngc6820/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-ngc6820/thumb.jpg</ThumbnailUrl>
      </ImageSet>
