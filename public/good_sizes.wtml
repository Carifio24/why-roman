  <Place Angle="0" AngularSize="1.855418322511555" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noirlab2018l&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-08-04T13:18:29+00:00&quot;}" Constellation="TAU" DataSetType="Sky" Dec="15.248416524210736" Magnitude="0" Name="Close-up of K2-25" Opacity="100" RA="4.218133391384576" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noirlab2018l/thumb.jpg" ZoomLevel="1.855418322511555">
