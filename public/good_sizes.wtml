  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02270&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:54+00:00&quot;}" Constellation="VIR" DataSetType="Sky" Dec="-11.623477925058038" Magnitude="0" Name="M104, NGC 4594" Opacity="100" RA="12.666413711064111" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02270/thumb.jpg" ZoomLevel="1.8054000000000001">
