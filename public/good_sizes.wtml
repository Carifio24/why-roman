      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="0" Constellation="AND" DataSetType="Sky" Dec="41.4394151121594" Magnitude="0" Name="Andromeda Galaxy" Opacity="100" RA="0.725512222819737" Rotation="0" Thumbnail="http://wwtfiles.blob.core.windows.net/vamp/thumb-Spitzer-sig06-025.jpg" ZoomLevel="5.33106682525819">
