  <Place Angle="0" AngularSize="2.4437159999999993" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-arp286&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:46.442089+00:00&quot;}" Constellation="VIR" DataSetType="Sky" Dec="3.9452892902680374" Magnitude="0" Name="Arp 286 (NGC 5560, 5566 &amp; 5569)" Opacity="100" RA="14.3395390287221" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-arp286/thumb.jpg" ZoomLevel="2.4437159999999993">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. Arp 286 consists of three galaxies that are gravitationally interacting. The large spiral galaxy at the center is NGC 5566. Below and to its left is the small, blue spiral galaxy NGC 5569. At the top of the image is the distorted spiral NGC 5560. It is presumably distorted by the gravity of NGC 5569. The image was generated with observations in B (blue), V (green) and I (red) filters. In this image, North is left, East is down.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.29736959999999996" BaseTileLevel="0" BottomsUp="False" CenterX="215.12419242847446" CenterY="3.863451950122922" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Arp 286 (NGC 5560, 5566 &amp; 5569)" OffsetX="-0.0815171380056" OffsetY="0.0314012658498" Projection="Tan" QuadTreeMap="" Rotation="-89.67016639866657" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-arp286/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-arp286" Xcxstatus="in:6427628e975014bc743f1695">
        <Credits>T.A. Rector (University of Alaska Anchorage) and H. Schweiker (WIYN and NOIRLab/NSF/AURA)</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-arp286/</CreditsUrl>
