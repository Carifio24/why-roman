  <Place Angle="0" AngularSize="3.950419199999999" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-ic1311&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:04.727773+00:00&quot;}" Constellation="CYG" DataSetType="Sky" Dec="41.21756815611766" Magnitude="0" Name="Open Cluster IC 1311" Opacity="100" RA="20.187123681767012" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-ic1311/thumb.jpg" ZoomLevel="3.950419199999999">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. IC 1311 is an open cluster of stars (seen near the top center of the image) that is embedded in a giant emission nebula. The nebula is glowing from the ultraviolet light from hot, massive blue stars in the nebula. The image was generated with observations in B (blue), V (green), I (orange) and Hydrogen-Alpha (red) filters. In this image, North is left, East is down.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="1.1911103089822097" BaseTileLevel="0" BottomsUp="False" CenterX="302.8112264640715" CenterY="41.338920520577965" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Open Cluster IC 1311" OffsetX="0.12147165845789998" OffsetY="0.002878279331199988" Projection="Tan" QuadTreeMap="" Rotation="-89.87773381855501" Sparse="True" StockSet="False" TileLevels="6" Url="http://data1.wwtassets.org/feeds/noirlab/noao-ic1311/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:64276294975014bc743f16a2">
        <Credits>T.A. Rector (University of Alaska Anchorage) and H. Schweiker (WIYN and NOIRLab/NSF/AURA)</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-ic1311/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-ic1311/thumb.jpg</ThumbnailUrl>
      </ImageSet>
