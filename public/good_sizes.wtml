  </Place>
  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noirlab2016b&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-07-02T13:00:00+00:00&quot;}" Constellation="TRI" DataSetType="Sky" Dec="33.58041057306817" Magnitude="0" Name="Cosmic Fireworks (wide angle)" Opacity="100" RA="2.4553699508971976" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noirlab2016b/thumb.jpg" ZoomLevel="2.595350875153852">
    <Description>The spiral galaxy NGC 925 reveals cosmic pyrotechnics in its spiral arms where bursts of star formation are taking place in the red, glowing clouds scattered throughout it.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.5952093025067008" BaseTileLevel="0" BottomsUp="False" CenterX="36.8305500384" CenterY="33.5805133241" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Cosmic Fireworks (wide angle)" OffsetX="7.26573855599e-05" OffsetY="7.26573855599e-05" Projection="Tan" QuadTreeMap="" Rotation="-134.64000000000013" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noirlab2016b/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noirlab2016b" Xcxstatus="in:64276308975014bc743f1799">
        <Credits>KPNO/NOIRLab/NSF/AURA Acknowledgements:PI: M T. Patterson (New Mexico State University)Image processing: Travis Rector (University of Alaska Anchorage), Mahdi Zamani &amp;amp; Davide de Martin  </Credits>
