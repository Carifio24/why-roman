  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noirlab2012b&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-04T03:00:00+00:00&quot;}" Constellation="IND" DataSetType="Sky" Dec="-59.94737056476766" Magnitude="0" Name="Excerpt of main image with lensing map" Opacity="100" RA="22.030791046827215" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noirlab2012b/thumb.jpg" ZoomLevel="2.135608147864123">
    <Description>Galaxy clusters are massive conglomerations of hundreds or even thousands of galaxies, bound together by their mutual gravitational attraction.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.5986689233584128" BaseTileLevel="0" BottomsUp="False" CenterX="330.461862821" CenterY="-59.947473905" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Excerpt of main image with lensing map" OffsetX="7.30797025584e-05" OffsetY="7.30797025584e-05" Projection="Tan" QuadTreeMap="" Rotation="45.800000000000054" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noirlab2012b/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noirlab2012b" Xcxstatus="in:64276303975014bc743f178e">
        <Credits>CTIO/NOIRLab/NSF/AURA</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noirlab2012b/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noirlab2012b/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noirlab2012d&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-04T03:00:00+00:00&quot;}" Constellation="IND" DataSetType="Sky" Dec="-59.94737056476766" Magnitude="0" Name="Excerpt of main image without lensing map" Opacity="100" RA="22.030791046827215" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noirlab2012d/thumb.jpg" ZoomLevel="2.135608147864123">
    <Description>LoVoCCS takes advantage of an astrophysical phenomenon called weak gravitational lensing to measure the mass and matter distributions of these clusters.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.5986689233584128" BaseTileLevel="0" BottomsUp="False" CenterX="330.461862821" CenterY="-59.947473905" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Excerpt of main image without lensing map" OffsetX="7.30797025584e-05" OffsetY="7.30797025584e-05" Projection="Tan" QuadTreeMap="" Rotation="45.800000000000054" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noirlab2012d/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noirlab2012d" Xcxstatus="in:64276304975014bc743f1790">
