  <Place Angle="0" AngularSize="0" Constellation="VEL" DataSetType="Sky" Dec="-47.5003611" Magnitude="0" Name="Image File" Opacity="100" RA="8.98730200666667" Rotation="0" Thumbnail="http://wwtfiles.blob.core.windows.net/vamp/thumb-Chandra-581a.jpg" ZoomLevel="2.00966684672">
