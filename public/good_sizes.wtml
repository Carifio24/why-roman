  <Place Angle="0" AngularSize="3.7771171199999998" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-ngc3628&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:57.671790+00:00&quot;}" Constellation="LEO" DataSetType="Sky" Dec="13.583938804515551" Magnitude="0" Name="Edge-on Spiral Galaxy NGC 3628" Opacity="100" RA="11.337640262302067" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-ngc3628/thumb.jpg" ZoomLevel="3.7771171199999998">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. NGC 3628 is a large, edge-on spiral galaxy. It is one of three galaxies in the &amp;quot;Leo Triplet&amp;quot;. NGC 3628 has a warped disk and a long tidal tail (the faint blue line stretching to the upper-left corner of the image) that are the result of gravitational interactions with the other two galaxies in the triplet. The image was generated with observations in the B (blue), V (green), I (orange) and Hydrogen-Alpha (red) filters. This image is rotated 37 degrees clockwise fron North is up, East is to the left.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.5906432" BaseTileLevel="0" BottomsUp="False" CenterX="170.10750498094487" CenterY="13.414403961746196" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Edge-on Spiral Galaxy NGC 3628" OffsetX="0.1355307934857" OffsetY="0.1100329436283" Projection="Tan" QuadTreeMap="" Rotation="37.06167406376881" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noao-ngc3628/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-ngc3628" Xcxstatus="in:642762d0975014bc743f1722">
        <Credits>T.A. Rector (University of Alaska Anchorage) and H. Schweiker (WIYN and NOIRLab/NSF/AURA)</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-ngc3628/</CreditsUrl>
