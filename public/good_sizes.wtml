        <CreditsUrl>https://noirlab.edu/public/images/noao-m100/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-m100/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="2.279441490994466" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-jones1&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:05+00:00&quot;}" Constellation="PEG" DataSetType="Sky" Dec="30.47152096994215" Magnitude="0" Name="Jones 1, PK 104-29.1" Opacity="100" RA="23.598707913794158" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-jones1/thumb.jpg" ZoomLevel="2.279441490994466">
    <Description>PK 104-29.1, also known as &amp;quot;Jones 1&amp;quot;, is a very faint, ghostlike planetary nebula in the constellation of Pegasus. This image was taken at the Mayall telescope with the Mosaic camera, with [OIII] (assigned a blue color) and H-alpha (orange) filters. In the image North is up and East is to the left. Imaged August 28, 2009.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.29565639240744956" BaseTileLevel="0" BottomsUp="False" CenterX="353.9751241897642" CenterY="30.45106960515028" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Jones 1, PK 104-29.1" OffsetX="0.0047709234871792915" OffsetY="0.0033985431625724767" Projection="Tan" QuadTreeMap="" Rotation="-0.11998750000006171" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-jones1/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:6427629c975014bc743f16b3">
        <Credits>T.A. Rector/University of Alaska Anchorage, H. Schweiker/WIYN and NOIRLab/NSF/AURA</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-jones1/</CreditsUrl>
