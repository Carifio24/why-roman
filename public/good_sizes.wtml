        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/noao-02172/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="5.7727512" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02173&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:06+00:00&quot;}" Constellation="SGR" DataSetType="Sky" Dec="-24.3476874062275" Magnitude="0" Name="The Lagoon Nebula, M8 (NGC 6523)" Opacity="100" RA="18.068926089442" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02173/thumb.jpg" ZoomLevel="5.7727512">
    <Description>The Lagoon Nebula, Messier object 8 (M8) or NGC 6523, in the constellation of Sagittarius, as seen by the Kitt Peak 4-meter Mayall telescope in 1973. North is at the top. The lagoon nebula glows with the red light of hydrogen (H alpha) excited by the radiation of very hot stars buried within its center. Deep within the cloud, dark filaments of obscuring matter emit strong infrared radiation. Several peculiar variable stars in the nebula occasionally flare up, increasing in brightness to some 25 times their normal luminosity. The nebula is about 6500 light-years away and about 60 light-years across.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.9604721290504625" BaseTileLevel="0" BottomsUp="False" CenterX="271.1122154664015" CenterY="-24.297940087676924" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="The Lagoon Nebula, M8 (NGC 6523)" OffsetX="0.085513551501" OffsetY="-0.05461941176100001" Projection="Tan" QuadTreeMap="" Rotation="-0.1928913999999224" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-02173/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-02173" Xcxstatus="in:64276266975014bc743f1640">
