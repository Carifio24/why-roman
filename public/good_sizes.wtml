  <Place Angle="0" AngularSize="2.2326677999999998" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-mwp1&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:34:08.437788+00:00&quot;}" Constellation="CYG" DataSetType="Sky" Dec="34.1973031867715" Magnitude="0" Name="Planetary Nebula MWP1" Opacity="100" RA="21.286306665665897" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-mwp1/thumb.jpg" ZoomLevel="2.2326677999999998">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. MWP1 is a very usually shaped, unusually large, and unusually old, planetary nebulae. The progenitor star is also one of the hottest stars known, so hot it is producing large amounts of X-rays. The image was generated with observations in the Oxygen [OIII] (blue) and Hydrogen-Alpha (orange) filters. In this image, North is up, East is to the left.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.2973696" BaseTileLevel="0" BottomsUp="False" CenterX="319.3244255734046" CenterY="34.15739109817035" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Planetary Nebula MWP1" OffsetX="0.024676087616400003" OffsetY="0.03973092826626" Projection="Tan" QuadTreeMap="" Rotation="0.09357263158" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-mwp1/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-mwp1" Xcxstatus="in:642762c5975014bc743f170a">
