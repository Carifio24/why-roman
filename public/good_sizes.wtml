  <Place Angle="0" AngularSize="2.0902676399999995" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-ngc7635podi&quot;, &quot;publishedUTCISO8601&quot;: &quot;2012-09-04T00:00:00+00:00&quot;}" Constellation="CAS" DataSetType="Sky" Dec="61.16567970874457" Magnitude="0" Name="Bubble Nebula (NGC 7635)" Opacity="100" RA="23.344935656422123" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-ngc7635podi/thumb.jpg" ZoomLevel="2.0902676399999995">
    <Description>This central, cosmetically corrected view of NGC 7635 shows the nebulosity carved out by the winds of the massive central star and demonstrates the exquisite image quality of the new One Degree Imager camera on the WIYN 3.5-m telescope. A wide-view image of the nebula, demonstrating the large field of view of the camera, is found here.  For more information, see NOAO Press Release 12-07.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.2506752" BaseTileLevel="0" BottomsUp="False" CenterX="350.2391222610383" CenterY="61.07201785701588" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Bubble Nebula (NGC 7635)" OffsetX="0.0319235079564" OffsetY="0.09320475366143999" Projection="Tan" QuadTreeMap="" Rotation="0.4170227987" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noao-ngc7635podi/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-ngc7635podi" Xcxstatus="in:642762d9975014bc743f1735">
        <Credits>T.A. Rector (University of Alaska Anchorage), WIYN ODI team &amp;amp; WIYN/NOIRLab/NSF/AURA</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/noao-ngc7635podi/</CreditsUrl>
