  <Place Angle="0" AngularSize="-1" Classification="Nebula" Constellation="ARA" DataSetType="Sky" Dec="-48.865" Magnitude="0" Name="Massive Young Stars Trigger Stellar Birth;RCW 108" Opacity="100" RA="16.6663888888889" Rotation="0" ZoomLevel="4.5">
    <ForegroundImageSet>
      <ImageSet BandPass="IR" BaseDegreesPerTile="0.410301831724349" BaseTileLevel="0" BottomsUp="False" CenterX="249.990726229991" CenterY="-48.8675650054926" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Massive Young Stars Trigger Stellar Birth;RCW 108" OffsetX="0.026568540525233" OffsetY="0.0102836946263746" Projection="Tan" QuadTreeMap="" Rotation="2.56739074444567e-16" Sparse="True" StockSet="False" TileLevels="4" Url="http://www.worldwidetelescope.org/wwtweb/tiles.aspx?q={1},{2},{3},152197268" WidthFactor="2" Xcxstatus="in:64b744d7a15b29de42b30657">
        <Credits>NASA/JPL-Caltech/CXO/CfA. RCW 108 is a region where stars are actively forming within the Milky Way galaxy about 4,000 light years from Earth. This is a complicated region that contains young star clusters, including one that is deeply embedded in a cloud of molecular hydrogen. By using data from different telescopes, astronomers determined that star birth in this region is being triggered by the effect of nearby, massive young stars.</Credits>
        <CreditsUrl>https://www.spitzer.caltech.edu/image/sig08-015-massive-young-stars-trigger-stellar-birth</CreditsUrl>
        <ThumbnailUrl>http://www.worldwidetelescope.org/wwtweb/thumbnail.aspx?name=152197268</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="0" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02283&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:52.019624+00:00&quot;}" Constellation="UMA" DataSetType="Sky" Dec="69.07915205824399" Magnitude="0" Name="M81, NGC 3031" Opacity="100" RA="9.925340331158507" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02283/thumb.jpg" ZoomLevel="4.515305399999999">
    <Description>M81, a type Sb spiral galaxy in the constellation Ursa Major, as seen by the KPNO 4-meter Mayall telescope in 1975.</Description>
