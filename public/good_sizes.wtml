  <Place Angle="0" AngularSize="1.8075626855286" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;iotw2051b&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-12-17T15:22:10+00:00&quot;}" Constellation="CEN" DataSetType="Sky" Dec="-30.408477122436516" Magnitude="0" Name="NGC 5291" Opacity="100" RA="13.789745905595524" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/iotw2051b/thumb.jpg" ZoomLevel="1.8075626855286">
    <Description>This observation from the SMARTS 0.9-meter Telescope at Cerro Tololo Inter-American Observatory shows the result of a truly spectacular galactic collision. The elliptical galaxy NGC 5291 — the hazy oval cloud at the center of this image — was struck by a careening rogue galaxy over 300 million years ago. The aftermath of this cataclysmic collision is a ring of galactic debris — visible as the tenuous luminous clouds spreading left and right from the golden oval of NGC 5291. This image also shows more gentle galactic interactions — NGC 5291 is interacting sedately with the unusually curved galaxy to the right of it, which is known as the Seashell.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.228833690624" BaseTileLevel="0" BottomsUp="False" CenterX="206.83689968273362" CenterY="-30.36660281240004" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 5291" OffsetX="0.04187860640071585" OffsetY="-0.008529281706181474" Projection="Tan" QuadTreeMap="" Rotation="-89.69520821243016" Sparse="True" StockSet="False" TileLevels="3" Url="http://data1.wwtassets.org/feeds/noirlab/iotw2051b/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|iotw2051b" Xcxstatus="in:6427625f975014bc743f1633">
        <Credits>CTIO/NOIRLab/NSF/AURA Acknowledgments: Travis Rector (University of Alaska Anchorage), Mahdi Zamani &amp;amp; Davide de Martin</Credits>
        <CreditsUrl>https://noirlab.edu/public/images/iotw2051b/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/noirlab/iotw2051b/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
