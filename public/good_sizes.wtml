        <CreditsUrl>https://www.eso.org/public/images/potw1908a/</CreditsUrl>
        <ThumbnailUrl>http://data1.wwtassets.org/feeds/eso/potw1908a/thumb.jpg</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
