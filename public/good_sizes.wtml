  <Place Angle="0" AngularSize="5.92925592" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-ngc660kpno&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:33:55.844858+00:00&quot;}" Constellation="PSC" DataSetType="Sky" Dec="13.6267186715053" Magnitude="0" Name="Polar Ring Galaxy, NGC 660" Opacity="100" RA="1.72050286893887" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-ngc660kpno/thumb.jpg" ZoomLevel="5.92925592">
    <Description>This image was obtained with the wide-field view of the Mosaic camera on the Mayall 4-meter telescope at Kitt Peak National Observatory. It shows NGC 660 and its surroundings. NGC 660 is a striking example of a polar ring galaxy. In the distant background are thousands of other galaxies. Nearly every small blue or yellow smudge is a very distant galaxy. Some of these, like NGC 660, show evidence of collisions or mergers. The image was generated with observations in the B (blue), V (green), I (orange) and Hydrogen-Alpha (red) filters. In this image, North is up, East is to the left.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.5908032107174787" BaseTileLevel="0" BottomsUp="False" CenterX="25.901934721713555" CenterY="13.734058059178714" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Polar Ring Galaxy, NGC 660" OffsetX="0.10485033400800002" OffsetY="-0.1286022482428" Projection="Tan" QuadTreeMap="" Rotation="-0.025189272782047068" Sparse="True" StockSet="False" TileLevels="5" Url="http://data1.wwtassets.org/feeds/noirlab/noao-ngc660kpno/L{1}X{2}Y{3}.png" WidthFactor="2" Xastropix_ids="noirlab|noao-ngc660kpno" Xcxstatus="in:642762d6975014bc743f172d">
