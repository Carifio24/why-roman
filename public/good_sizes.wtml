  <Place Angle="0" AngularSize="0" Constellation="AND" DataSetType="Sky" Dec="41.269236" Magnitude="0" Name="M31" Opacity="100" RA="0.712319733333333" Rotation="0" Thumbnail="http://wwtfiles.blob.core.windows.net/vamp/thumb-Chandra-447.jpg" ZoomLevel="4.9581194147797">
