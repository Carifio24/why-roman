  <Place Angle="0" AngularSize="2.9579999999999993" Annotation="{&quot;channel&quot;: &quot;noirlab&quot;, &quot;itemid&quot;: &quot;noao-02464&quot;, &quot;publishedUTCISO8601&quot;: &quot;2020-06-30T21:53:15+00:00&quot;}" Constellation="CAS" DataSetType="Sky" Dec="58.2851206307643" Magnitude="0" Name="NGC 457 in Cassiopeia" Opacity="100" RA="1.32584016737233" Rotation="0" Thumbnail="http://data1.wwtassets.org/feeds/noirlab/noao-02464/thumb.jpg" ZoomLevel="2.9579999999999993">
    <Description>An open star cluster in the constellation Cassiopeia, NGC457 is composed of relatively young stars (only about 10 million years old). It is located some 9300 light-years from Earth and is about 30 light-years across. KPNO 2.1-meter telescope, 1975.</Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="0.5939199999999999" BaseTileLevel="0" BottomsUp="False" CenterX="19.83797863" CenterY="58.25437731" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="NGC 457 in Cassiopeia" OffsetX="-0.023714627430000006" OffsetY="0.03242709079049999" Projection="Tan" QuadTreeMap="" Rotation="-0.13171844517356715" Sparse="True" StockSet="False" TileLevels="4" Url="http://data1.wwtassets.org/feeds/noirlab/noao-02464/L{1}X{2}Y{3}.png" WidthFactor="2" Xcxstatus="in:64276283975014bc743f167d">
